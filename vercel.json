{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ],
  "crons": [
    { "path": "/api/cron/deliver-leads", "schedule": "0 6 * * *" }
  ]
}
